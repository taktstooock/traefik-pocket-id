# host path
PATH_DOCKER_SOCKET=/var/run/docker.sock
PATH_LOGS_DIR=/var/log/traefik

# volumes
# These paths should be absolute paths on the host machine
VOLUME_TRAEFIK_LETSENCRYPT_PATH=/mnt/data/volumes/traefik_letsencrypt
VOLUME_POCKET_ID_DATA_PATH=/mnt/data/volumes/pocket_id_data

# networks
# One network per app routed by Traefik (see README). Pick private ranges that overlap no other network on the host
TRAEFIK_NETWORK_1_CIDR=172.21.1.0/24
# TRAEFIK_NETWORK_2_CIDR=172.21.2.0/24

# Pocket ID
# Public hostname of Pocket ID (e.g. id.example.com)
POCKET_ID_HOST=
# Encrypts sensitive data such as token signing keys. Store a copy outside this host: a backup cannot be restored without it.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
# SMTP server for new-device login notifications. Use the credentials issued by your mail provider
SMTP_HOST=
SMTP_PORT=465
SMTP_TLS=tls
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# oauth2-proxy
# Shown once when the OIDC client is created in Pocket ID (see README)
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
# Encrypts the session cookie. Generate with: openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=
# Domains of the apps that users may be sent back to after login, comma separated, with a leading dot for subdomains (e.g. .example.com)
OAUTH2_PROXY_WHITELIST_DOMAINS=
